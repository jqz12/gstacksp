{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|clear|compact",
      "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/gsp.py\" hook", "timeout": 15}]
    }],
    "PreToolUse": [{
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/gsp.py\" hook", "timeout": 15}]
    }]
  }
}
